PROGRAM main
  VAR
    START_BUTTON : BOOL AT %IX0.0; (* Start push button *)
    STOP_BUTTON : BOOL AT %IX0.1; (* Stop push button *)
    LOW_LEVEL : BOOL AT %IX0.2; (* TRUE = water above low switch *)
    HIGH_LEVEL : BOOL AT %IX0.3; (* TRUE = water at high switch *)
    SYSTEM_ON : BOOL; (* Internal memory: system is running *)
    PUMP : BOOL AT %QX0.0; (* Pump output *)
    FULL_LAMP : BOOL AT %QX0.1; (* Tank full lamp *)
  END_VAR

